#. Plugin Name of the plugin
msgid "AI Assistant & Chatbox"
msgstr ""

#. Plugin URI of the plugin
msgid "https://github.com/fazrilamin/aichatbox"
msgstr ""

#. Description of the plugin
msgid "AI search and chat for your website, answered from your own pages with OpenAI, Gemini, Claude, DeepSeek, Groq, OpenRouter, Ollama or any OpenAI-compatible API. Also makes the site AI-friendly: llms.txt, llms-full.txt, Markdown versions of pages and AI crawler rules in robots.txt. Includes snippets, starter questions and a conversation log."
msgstr ""

#. Author of the plugin
msgid "Fazril Amin"
msgstr ""

#. Author URI of the plugin
msgid "https://faztech.my"
msgstr ""

